[Unit]
Description=IpswichSuite DMR Server
After=network.target

[Service]
Type=simple
User=ipswich
Group=ipswich
WorkingDirectory=/opt/ipswichsuite
ExecStart=/opt/ipswichsuite/venv/bin/python /opt/ipswichsuite/run.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipswichsuite

[Install]
WantedBy=multi-user.target
